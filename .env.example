# Copy to .env for local development:   cp .env.example .env
#
# .env is gitignored and is a LOCAL CONVENIENCE ONLY. Real environment
# variables always take precedence, so on the server these belong in the
# systemd/gunicorn unit's Environment= rather than in a file.

# MongoDB. The production host is not reachable from a laptop — either run on
# the server, or open your SSH tunnel and point this at localhost.
MONGODB_URI=mongodb://user:pass@localhost:27017/hurricanes?authSource=admin

# Signs the Flask session cookie for the front editor.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
#
# Every gunicorn worker MUST use the same value or users appear randomly
# logged out as requests land on different workers. Rotating it logs everyone
# out, which is the intended way to revoke all sessions at once.
# If unset, the public dashboard still serves; sign-in and /fronts return 503.
FLASK_SECRET_KEY=

# Local development over plain HTTP only. Leave unset behind HTTPS so the
# session cookie is Secure.
AUTH_INSECURE_COOKIE=1

# CMEMS (already used by ioos_model_comparisons/models.py)
CMEMS_USERNAME=
CMEMS_PASSWORD=
